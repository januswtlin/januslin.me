{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "lib": ["esnext", "dom"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "allowJs": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "*.config.ts", "scripts/**/*.ts"],
  "exclude": ["dist", "node_modules", "drafts", ".claude", ".pnpm-store"]
}
