# Local-only drafts: never committed (ADR-0004). Only the README is tracked.
/drafts/*
!/drafts/README.md

# Dependencies (pnpm may place its store at the checkout root)
node_modules/
.pnpm-store/

# Build output (anchored so tests/dist/ stays tracked)
/dist/
/.astro/
/.wrangler/
.logs/

# Python bytecode from the script tests
__pycache__/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment
.env*
!.env.example

# Test output
test-results/
playwright-report/
coverage/

# OS / editor
.DS_Store
.obsidian/workspace*.json

# Claude Code: subagent worktrees and personal settings stay local
/.claude/worktrees/
/.claude/settings.local.json
