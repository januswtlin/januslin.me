#!/bin/sh
# Git credential helper for the `agent` account (ADR-0009). Answers only for
# https://github.com/januswtlin/januslin.me with the januslin-agent token file.
#   git config --local credential.helper ''
#   git config --local --add credential.helper '!/path/to/scripts/agent-git-credential'
#   git config --local credential.useHttpPath true
set -eu

[ "${1:-}" = "get" ] || exit 0

protocol= host= path=
while IFS='=' read -r key value; do
  case "$key" in
    protocol) protocol=$value ;;
    host) host=$value ;;
    path) path=$value ;;
  esac
done

[ "$protocol" = "https" ] && [ "$host" = "github.com" ] || exit 0
case "$path" in
  januswtlin/januslin.me|januswtlin/januslin.me.git) ;;
  *) exit 0 ;;
esac

token_file="${JANUSLIN_AGENT_STATE_DIR:-$HOME/.local/state/januslin-agent}/januslin-agent.token"
[ -r "$token_file" ] || { echo "agent-git-credential: no januslin-agent token; run scripts/agent-token.sh januslin-agent." >&2; exit 1; }

printf 'username=x-access-token\npassword=%s\n' "$(sed -n 1p "$token_file")"
