---
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/cjk.css";

import BaseHead, { type ArticleMeta } from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE } from "../config";
import { DEFAULT_LOCALE, HTML_LANG, t, type Locale } from "../i18n";

interface Props {
  /** Page locale; zh-tw unless the page is under /en/. */
  lang?: Locale;
  /** Page title, without the site name. Omit on the home page. */
  title?: string;
  description?: string;
  /** Absolute path or URL of the social preview image. */
  ogImage?: string;
  /** Present on article pages; drives OG type and structured data. */
  article?: ArticleMeta;
  /** Let the hero run under the header. */
  overlayHeader?: boolean;
}

const { lang = DEFAULT_LOCALE, title, ogImage, article, overlayHeader = false } = Astro.props;
const strings = t(lang);
const description = Astro.props.description ?? strings.siteDescription;

const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${strings.siteTagline}`;
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <BaseHead
      lang={lang}
      title={pageTitle}
      description={description}
      ogImage={ogImage}
      article={article}
    />
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">{strings.skipToContent}</a>
    <Header lang={lang} overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
