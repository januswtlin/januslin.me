---
import { NAV, SITE } from "../config";
import { localizePath, t, type Locale } from "../i18n";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  lang: Locale;
  /** Lay the header over the hero instead of pushing it down. */
  overlay?: boolean;
}

const { lang, overlay = false } = Astro.props;
const strings = t(lang);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const isCurrent = (href: string) => {
  const base = href.replace(/\/$/, "") || "/";
  return path === base || (base !== "/" && path.startsWith(`${base}/`));
};
---

<header class="site-header" data-overlay={overlay ? "" : undefined}>
  <a class="brand" href={localizePath(lang, "/")}>
    <span class="brand__mark">{SITE.title}</span>
  </a>

  <div class="site-header__end">
    <nav class="nav" aria-label={strings.navPrimary}>
      <ul class="nav__list">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {strings[item.key]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle lang={lang} />
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6) var(--gutter);
  }

  .site-header[data-overlay] {
    position: absolute;
    inset-inline: 0;
    top: 0;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    text-decoration: none;
  }

  .brand:hover {
    color: inherit;
  }

  .brand__mark {
    font-family: var(--font-mono);
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-4), 3vw, var(--space-8));
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-4), 3vw, var(--space-8));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-fg-muted);
  }

  .nav a:hover,
  .nav a[aria-current="page"] {
    color: var(--color-fg);
  }

  .nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
  }

  @media (max-width: 40rem) {
    .site-header {
      padding-block: var(--space-4);
    }
  }
</style>
