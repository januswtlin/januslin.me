---
import BaseLayout from "../layouts/BaseLayout.astro";
import { DEFAULT_LOCALE, t } from "../i18n";

// One 404 page for the whole site, in the default locale.
const strings = t(DEFAULT_LOCALE);
---

<BaseLayout title={strings.notFoundTitle} description={strings.notFoundLede}>
  <section class="notfound wrap">
    <p class="notfound__code" aria-hidden="true">404</p>
    <p class="notfound__mark" aria-hidden="true">無</p>

    <h1 class="notfound__title">{strings.notFoundHeading}</h1>
    <p class="lede notfound__lede">{strings.notFoundLede}</p>

    <p class="notfound__actions label">
      <a href="/">{strings.home}</a>
      <span aria-hidden="true">·</span>
      <a href="/blog/">{strings.allPosts}</a>
    </p>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 60svh;
    padding-block: var(--space-24);
    text-align: center;
  }

  .notfound__code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }

  .notfound__mark {
    margin-top: var(--space-6);
    font-size: clamp(5rem, 18vw, 9rem);
    line-height: 1;
    color: var(--color-fg-faint);
  }

  .notfound__title {
    margin-top: var(--space-8);
    font-size: var(--text-xl);
  }

  .notfound__lede {
    max-width: 32rem;
    margin-top: var(--space-4);
  }

  .notfound__actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-12);
  }

  .notfound__actions a {
    text-decoration: none;
  }

  .notfound__actions a:hover {
    color: var(--color-accent);
  }
</style>
