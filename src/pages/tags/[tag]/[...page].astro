---
import type { GetStaticPaths, Page } from "astro";

import PageHeader from "../../../components/PageHeader.astro";
import Pagination from "../../../components/Pagination.astro";
import PostCard from "../../../components/PostCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { BLOG } from "../../../config";
import { DEFAULT_LOCALE, t } from "../../../i18n";
import {
  collectTags,
  getPublishedPosts,
  postsByTag,
  type Post,
} from "../../../utils/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts(DEFAULT_LOCALE);

  return (await collectTags(posts, DEFAULT_LOCALE)).flatMap((tag) =>
    paginate(postsByTag(posts, tag.slug), {
      params: { tag: tag.slug },
      pageSize: BLOG.postsPerPage,
      props: { tagName: tag.name },
    }),
  );
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
  tagName: string;
}

const { page, tagName } = Astro.props;
// Tag archives exist in the default locale only until T11.
const lang = DEFAULT_LOCALE;
const strings = t(lang);

const suffix = page.currentPage > 1 ? ` — ${page.currentPage}` : "";
---

<BaseLayout
  lang={lang}
  title={`#${tagName}${suffix}`}
  description={strings.taggedDescription(tagName)}
>
  <div class="wrap">
    <PageHeader
      eyebrow={strings.taggedEyebrow}
      title={`#${tagName}`}
      lede={strings.taggedLede(page.total)}
    >
      <p class="tag-page__back label">
        <a href="/tags/">{strings.allTags}</a>
      </p>
    </PageHeader>

    <div class="post-list">
      {page.data.map((post) => <PostCard lang={lang} post={post} />)}
    </div>

    <Pagination lang={lang} page={page} label={strings.postsTagged(tagName)} />
  </div>
</BaseLayout>

<style>
  .tag-page__back {
    margin-top: var(--space-6);
  }

  .tag-page__back a {
    text-decoration: none;
  }

  .post-list {
    margin-top: var(--space-4);
  }

  .post-list :global(.post-card:last-child) {
    border-bottom: none;
  }
</style>
