---
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { DEFAULT_LOCALE, t } from "../../i18n";
import { collectTags, getPublishedPosts } from "../../utils/posts";

const posts = await getPublishedPosts();
const tags = collectTags(posts);
// The tag index exists in the default locale only until T11.
const lang = DEFAULT_LOCALE;
const strings = t(lang);

const pad = (n: number) => String(n).padStart(2, "0");
---

<BaseLayout lang={lang} title={strings.tagsTitle} description={strings.tagsDescription}>
  <div class="wrap">
    <PageHeader
      eyebrow={strings.tagsEyebrow}
      title={strings.tagsTitle}
      lede={strings.tagsLede(tags.length, posts.length)}
    />

    {
      tags.length > 0 ? (
        <ul class="tag-grid rule-grid">
          {tags.map((tag, index) => (
            <li>
              <a class="tag-cell" href={`/tags/${tag.slug}/`}>
                <span class="tag-cell__no label">{pad(index + 1)}</span>
                <span class="tag-cell__name">{tag.name}</span>
                <span class="tag-cell__count label">
                  {strings.postCount(tag.count)}
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="tag-grid__empty lede">{strings.tagsEmpty}</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .tag-grid {
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    margin-top: var(--space-12);
    padding: 0;
    list-style: none;
  }

  .tag-cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-height: 9rem;
    padding: var(--space-6);
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-out);
  }

  .tag-cell:hover {
    background: var(--color-bg-subtle);
    color: inherit;
  }

  .tag-cell__name {
    margin-top: auto;
    font-size: var(--text-lg);
  }

  .tag-cell:hover .tag-cell__name {
    color: var(--color-accent);
  }

  .tag-grid__empty {
    margin-top: var(--space-12);
  }
</style>
