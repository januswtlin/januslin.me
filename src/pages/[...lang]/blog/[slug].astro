---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";

import PostLayout from "../../../layouts/PostLayout.astro";
import { localeFromParam, localePaths } from "../../../i18n";
import { getAdjacentPosts, getPublishedPosts, type Post } from "../../../utils/posts";

// Every post renders in both locales until T10 adds per-locale entries and T11 the full routing.
export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();

  return localePaths().flatMap(({ params }) =>
    posts.map((post) => ({
      params: { ...params, slug: post.id },
      props: { post, ...getAdjacentPosts(posts, post.id) },
    })),
  );
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  previous?: Post;
  next?: Post;
}

const lang = localeFromParam(Astro.params.lang);
const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout lang={lang} post={post} headings={headings} previous={previous} next={next}>
  <Content />
</PostLayout>
