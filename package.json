{
  "name": "januslin.me",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^24.22.2",
    "pnpm": "^12.16.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build.js",
    "build:preview": "INCLUDE_DRAFTS=true node scripts/build.js",
    "preview": "astro preview",
    "astro": "astro",
    "apply-lqip": "tsx scripts/apply-lqip.ts",
    "check": "astro check && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "sh tests/scripts/run.sh && vitest run && playwright test",
    "verify": "pnpm check && pnpm lint && pnpm build && pnpm test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/mdx": "8.1.2",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.5",
    "astro-compress": "2.4.3",
    "astro-og-canvas": "0.13.3",
    "canvaskit-wasm": "0.42.0",
    "feed": "6.0.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "mdast-util-to-string": "4.0.0",
    "node-html-parser": "9.0.6",
    "reading-time": "1.5.0",
    "rehype-katex": "7.0.1",
    "rehype-mermaid": "3.0.0",
    "rehype-slug": "6.0.0",
    "remark-directive": "4.0.0",
    "remark-math": "6.0.0",
