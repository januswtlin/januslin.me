    "@types/node": "24.19.2",
    "@types/sanitize-html": "2.16.2",
    "@unocss/astro": "66.12.0",
    "@unocss/preset-attributify": "66.12.0",
    "@unocss/reset": "66.12.0",
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "fast-glob": "3.3.3",
    "globals": "17.14.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
